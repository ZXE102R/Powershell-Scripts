#This script returns all active AD accounts where password is older than 90 days

# Import Active Directory module (Ensure RSAT is installed)
Import-Module ActiveDirectory

# Define the 90-day threshold
$DaysThreshold = (Get-Date).AddDays(-90)

# Get all enabled users and filter those with password older than 90 days
$Users = Get-ADUser -Filter {Enabled -eq $true} -Properties DisplayName, SamAccountName, Enabled, pwdLastSet, LastLogonDate -SearchBase "OU=Users,OU=NYC,DC=comfed,DC=local"

# Process and filter users
$Report = $Users | Where-Object {($_.pwdLastSet -ne 0) -and ([datetime]::FromFileTime($_.pwdLastSet) -lt $DaysThreshold)} |
    Select-Object DisplayName, SamAccountName, Enabled, 
        @{Name="PasswordLastSet"; Expression={[datetime]::FromFileTime($_.pwdLastSet)}}, 
        LastLogonDate

# Export results to CSV
$Report | Export-Csv -Path "C:\Temp\Active_Users_Password_Older_Than_90_Days.csv" -NoTypeInformation

# Display results
$Report
