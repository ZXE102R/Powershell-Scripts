#This powershell script updates expiration date for accounts in Active directory 
# Import Active Directory Module
Import-Module ActiveDirectory

# Define the path to the CSV file
$csvPath = "C:\Temp\Expiring AD accounts.csv"

# Define the new expiration date
$ExpirationDate = Get-Date "02/25/2025"

# Import CSV and update expiration date for each user
Import-Csv -Path $csvPath | ForEach-Object {
    $SamAccountName = $_.SamAccountName
    if ($SamAccountName) {
        Set-ADUser -Identity $SamAccountName -AccountExpirationDate $ExpirationDate
        Write-Host "Updated expiration for $SamAccountName to $ExpirationDate"
    }
}

Write-Host "All users updated successfully."
