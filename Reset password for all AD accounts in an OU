#This script resets Password for all accounts in Onboarding OU

# Import the AD module
Import-Module ActiveDirectory

# Set the target OU
$ou = "OU=Onboarding,DC=XX,DC=XX"  

# Set the desired password (must meet complexity rules)
$newPassword = ConvertTo-SecureString -AsPlainText "Welcome12345!" -Force

#USE THIS $users VARIABLE FOR ENTIRE OU
#Get users from the OU
$users = Get-ADUser -SearchBase $ou -Filter { Enabled -eq $true } -Properties SamAccountName

#USE THIS VARIABLE IF GOING OFF OF A DESCRIPTION WITHIN OU
#Get only users with description = "Consultant"
#$users = Get-ADUser -SearchBase $ou -Filter { Description -eq "Consultant" } -Properties SamAccountName

# Ask for confirmation
$confirm = Read-Host "`nDo you want to proceed with resetting password for all users in Onboarding OU? (Y/N)"

if ($confirm -ne 'Y' -and $confirm -ne 'y') {
    Write-Host "`nAborted. No changes were made." -ForegroundColor Red
    return
}

# Loop through each user and set password
foreach ($user in $users) {
    try {
        Set-ADAccountPassword -Identity $user.DistinguishedName -NewPassword $newPassword -Reset
        Write-Host "Password reset for $($user.SamAccountName)" -ForegroundColor Green
    } catch {
        Write-Host "Failed to reset password for $($user.SamAccountName): $_" -ForegroundColor Red
    }
}

